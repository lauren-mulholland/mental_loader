# Copy to .env. Never commit real keys or calendar tokens.
DATABASE_URL=postgresql+psycopg://mental_loader:local_only@127.0.0.1:55432/mental_loader
PUBLIC_ORIGIN=http://localhost:8000
COOKIE_SECURE=false
# Shared-code browser login is also disabled automatically when a household enrolls accounts.
ALLOW_LEGACY_LOGIN=true
# Hosted mode refuses HTTP, insecure cookies, shared-code login and a missing private key.
HOSTED_MODE=false
# Generate once with: uv run python -m mental_loader.cli init-secrets
SECRET_KEY_PATH=.local/app-secret.key
GOOGLE_WEB_CLIENT_PATH=.local/google-web-client.json
# No paid model calls unless explicitly enabled here.
AI_ENABLED=false
# Model-provider keys belong in .local/hermes-home/.env, not this file.
# For OpenRouter: OPENROUTER_API_KEY=... in that private Hermes file.
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=
# Bind this dedicated Hermes runtime to exactly one household for this spike.
HERMES_HOUSEHOLD_ID=
AI_DAILY_CALL_LIMIT=20
# Generated locally with: uv run python -m mental_loader.cli init
VAPID_PRIVATE_KEY_PATH=.local/vapid-private.pem
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:replace-me@example.com
GOOGLE_CLIENT_SECRET_PATH=.local/google-client.json
